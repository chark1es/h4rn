# h4rn-connect deployment environment (ADR-018).
#
# Copy to `.env` next to `deploy/docker-compose.yml` and edit. Generate secrets
# with `openssl rand -base64 32`. Never commit a filled-in `.env`.

# --- Relay ---------------------------------------------------------------
# The URL clients use. Must be https in hosted mode.
H4RN_CONNECT_PUBLIC_BASE_URL=http://localhost:8787
H4RN_CONNECT_PORT=8787
# Published image tag (release workflow pushes ghcr.io/chark1es/h4rn-connect).
# Override for a local build with `-f deploy/docker-compose.build.yml`.
H4RN_CONNECT_IMAGE=ghcr.io/chark1es/h4rn-connect:1.1.0
H4RN_CONNECT_MODE=self_hosted
# Only for local development; requires the URL to be http.
H4RN_CONNECT_ALLOW_INSECURE=true

# 32 random bytes, base64 or hex. Encrypts provider refresh tokens and the
# idempotent refresh-successor window (ADR-016).
H4RN_CONNECT_KEK=
# 32-byte Ed25519 seed for h4rn session tokens. Required in hosted mode so
# sessions survive a restart; generated per boot when empty in self-hosted mode.
H4RN_CONNECT_SIGNING_KEY=

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
H4RN_CONNECT_CORS_ORIGINS=
# Built web UI to serve at `/`. Empty disables static serving.
H4RN_CONNECT_WEB_DIR=
# Trust X-Forwarded-For for rate limiting. Only behind a proxy that overwrites it.
H4RN_CONNECT_TRUST_FORWARDED_FOR=false
# Rate limits are per client IP. Zero disables a limit. Defaults shown.
# H4RN_CONNECT_RATE_PER_IP_PER_MINUTE=240
# H4RN_CONNECT_RATE_AUTH_PER_MINUTE=30
# H4RN_CONNECT_RATE_PAIRING_PER_HOUR=60
# H4RN_CONNECT_RATE_RELAY_CONNECTS_PER_MINUTE=120
# Failed pairing claims before a pairing is burned.
# H4RN_CONNECT_PAIRING_ATTEMPTS=10

# --- Postgres ------------------------------------------------------------
H4RN_PG_USER=h4rn
H4RN_PG_PASSWORD=
H4RN_PG_DATABASE=h4rn
H4RN_PG_PORT=5432

# --- OIDC providers ------------------------------------------------------
# A JSON array of providers. `id` is the URL segment in /v1/auth/<id>/*.
# OrbitID must be root-mounted with no trailing slash and no path prefix.
H4RN_CONNECT_OIDC_PROVIDERS=[]
# Example:
# H4RN_CONNECT_OIDC_PROVIDERS=[{"id":"orbitid","display_name":"OrbitID","issuer":"https://auth.example.com","client_id":"oa_...","client_secret":"...","scopes":["openid","profile","email","offline_access"],"redirect_uris":["http://127.0.0.1:53682/callback","h4rn://callback"],"device_grant":true}]

# --- Optional local OrbitID profile -------------------------------------
# H4RN_ORBITID_IMAGE=orbitid:local
# H4RN_ORBITID_PORT=4000
# ORBITID_BASE_URL=http://localhost:4000
# ORBITID_ENCRYPTION_KEY=
# ORBITID_PG_PASSWORD=orbitid

# --- Logging -------------------------------------------------------------
RUST_LOG=h4rn_connect=info,tower_http=info
