  "narrative": {
    "northStar": "Editorial workbench",
    "overview": "Mode: Operate. An editorial sensibility expressed through hierarchy, measure and alignment. Warm mineral light surfaces and green-black dark surfaces support long desk sessions and brief phone checks. The interface is a working application, without newspaper styling, serif flourishes, ruled paper, decorative numbering or invented jargon.\n\nThis is an isolated redesign proposal. It supersedes the incumbent look only inside `design/b-editorial/`; it does not update the application's root system. The user explicitly selected Direction B and asked for a self-contained code prototype. Demonstration data and model names are illustrative, not claims of live host connections or real usage. Google Fonts are the only external dependencies; system fallbacks remain usable offline.",
    "keyCharacteristics": [
      "A wordmark replaces the orange logo tile so the task owns the strongest visual emphasis.",
      "A low-chroma warm ground softens bright environments without adding simulated paper texture.",
      "Deep teal is the single working accent; red and ochre communicate exceptions only.",
      "Manrope gives headings a compact, clear silhouette; Source Sans 3 carries dense operational text.",
      "A shared left alignment links titles, tool names, file summaries and reply controls, making scan paths predictable.",
      "Provenance is a plain sentence beneath the task, not a collection of header badges.",
      "Inbox rows use title, location and state; removing decorative counters strengthens meaningful ordering.",
      "Identity marks appear at host, harness and child-agent boundaries; live orbs appear only beside active work.",
      "Approvals expose the command, machine, directory and permission scope before the action.",
      "Phone layouts change the navigation and decision flow: one pane, bottom navigation, sheets and large targets."
    ],
    "rules": [
      {
        "name": "Decision",
        "body": "Accent signals something actionable, selected or live. Identity color is subdued. Do not use teal as a decorative field.",
        "section": "Components"
      },
      {
        "name": "Code",
        "body": "Monospace has semantic work to do. Never use it for navigation, section labels, counters or ornamental technical flavor.",
        "section": "Components"
      },
      {
        "name": "Provenance",
        "body": "At a decision, show host and harness. A model without its execution location is incomplete information.",
        "section": "Components"
      }
    ],
    "dos": [
      "Do preserve the familiar workbench structure, align operational text, keep location visible, and let the work carry the visual weight."
    ],
    "donts": [
      "Don\u2019t revive stage terminology, cue counters, amber gutters, numbered rows, logo blocks, pill-filled headers or decorative blob fields."
    ]
  }
}