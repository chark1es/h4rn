{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "h4rn",
  "mainBinaryName": "h4rn",
  "version": "1.0.0",
  "identifier": "dev.h4rn.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "h4rn",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/h4rnd"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["h4rn"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/chark1es/h4rn/releases/latest/download/latest.json"
      ],
      "pubkey": "__H4RN_UPDATER_PUBKEY__",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
