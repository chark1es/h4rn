<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist by Tauri (bundle.iOS.infoPlist).

  The socket is not the security boundary: device-to-daemon traffic runs inside
  a Noise session whose daemon static key is pinned from the pairing payload
  (ADR-010, ADR-031), so a ws:// candidate adds no confidentiality or integrity
  loss. NSAllowsLocalNetworking lets the app reach unqualified names and .local,
  and the exception domains cover .local and ts.net (MagicDNS).

  ATS matches DNS names, not address ranges, so private and CGNAT IP literals
  cannot be listed here. Whether iOS 17 admits a raw ws:// connection to such
  an address without an ATS exception is unverified on this host: iOS apps are
  built only by the macOS CI job, which does not run them. This is an accepted
  limitation; a phone that cannot use a direct IP path falls back to the relay.
  See docs/mobile.md and docs/transport.md.
-->
<plist version="1.0">
<dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>local</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
            <key>ts.net</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
