{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "h4rn",
  "version": "1.0.1",
  "identifier": "dev.h4rn.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "h4rn",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["h4rn"]
      },
      "mobile": [
        {
          "scheme": ["h4rn"]
        }
      ]
    }
  }
}
