<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>push_agents_need_attention</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@agents@</string>
		<key>agents</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld agente necesita atención</string>
			<key>many</key>
			<string>%ld agentes necesitan atención</string>
			<key>other</key>
			<string>%ld agentes necesitan atención</string>
		</dict>
	</dict>
	<key>push_agents_finished</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@agents@</string>
		<key>agents</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld agente terminó</string>
			<key>many</key>
			<string>%ld agentes terminaron</string>
			<key>other</key>
			<string>%ld agentes terminaron</string>
		</dict>
	</dict>
</dict>
</plist>
